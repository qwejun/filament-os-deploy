# ============================================
# Filament OS 部署配置
# ============================================

# 应用端口（默认 2233）
PORT=2233

# 管理员账号配置
ADMIN_USER=admin
ADMIN_PASS=ChangeMe123

# ============================================
# 打印机服务配置
# ============================================
# 打印机服务通过 Web UI 登录，无需在此处配置账号密码
# 首次启动后访问 http://your-nas-ip:2233/printers 进行登录

# 可选：高级配置
# DATABASE_URL=file:/app/data/database.sqlite
# NITRO_PORT=2233
# CONNECTION_MODE=cloud
# FLASK_PORT=5000
